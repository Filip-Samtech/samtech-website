---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Här skapar vi dynamiska variabler (Props) för SEO
export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

// Om inget annat anges på en specifik sida, används dessa standardvärden:
const { 
  title = "SamTech AB | Premium AV & Konferenslösningar", 
  description = "Vi designar, installerar och underhåller premiumlösningar för mötesrum, kontor och offentliga miljöer. Vi gör tekniken osynlig och upplevelsen magisk.",
  image = "/og-image.jpg" // Denna bild måste vi lägga till i public-mappen!
} = Astro.props;
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
  </head>
  
  <body class="bg-white text-sam-blue font-sans selection:bg-sam-cyan selection:text-white flex flex-col min-h-screen">
    <Navbar />
    <main class="flex-grow">
      <slot /> 
    </main>
    <Footer />
  </body>
</html>