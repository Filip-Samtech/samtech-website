---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Karriär & Lediga Tjänster | SamTech AB" 
  description="Vill du jobba med premium AV-teknik? Vi letar alltid efter nya talanger och erfarna tekniker. Skicka in din ansökan idag!"
>
  <header class="bg-sam-blue text-white py-20 px-4 text-center">
    <div class="max-w-4xl mx-auto mt-10">
      <h1 class="text-5xl font-bold mb-6 tracking-tight">Karriär på <span class="text-sam-cyan">SamTech</span></h1>
      <p class="text-xl text-gray-300 font-medium">
        Vi letar alltid efter talanger som brinner för AV-teknik och installationer. Bli en del av vårt team!
      </p>
    </div>
  </header>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="bg-white rounded-3xl p-10 md:p-12 border border-gray-100 shadow-2xl">
      <div class="border-b border-gray-100 pb-6 mb-8">
        <h2 class="text-3xl font-bold text-sam-blue">Skicka in din ansökan</h2>
        <p class="text-sm text-gray-500 mt-2">Fyll i dina uppgifter nedan. När du klickar på knappen öppnas ditt e-postprogram så att du enkelt kan bifoga ditt CV.</p>
      </div>

      <form id="career-form" class="space-y-6">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-semibold text-sam-blue mb-2">För- och efternamn *</label>
            <input type="text" id="name" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-2xl text-sam-blue focus:outline-none focus:border-sam-cyan focus:ring-2 focus:ring-sam-cyan/20 transition-all font-medium" placeholder="Ex. Anna Andersson" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-semibold text-sam-blue mb-2">Telefonnummer *</label>
            <input type="tel" id="phone" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-2xl text-sam-blue focus:outline-none focus:border-sam-cyan focus:ring-2 focus:ring-sam-cyan/20 transition-all font-medium" placeholder="070-000 00 00" />
          </div>
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-sam-blue mb-2">E-postadress *</label>
          <input type="email" id="email" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-2xl text-sam-blue focus:outline-none focus:border-sam-cyan focus:ring-2 focus:ring-sam-cyan/20 transition-all font-medium" placeholder="namn@exempel.se" />
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-sam-blue mb-2">Kort presentation *</label>
          <textarea id="message" rows="4" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-2xl text-sam-blue focus:outline-none focus:border-sam-cyan focus:ring-2 focus:ring-sam-cyan/20 transition-all font-medium resize-none" placeholder="Berätta lite kort om dig själv och varför du vill jobba med oss..."></textarea>
        </div>

        <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-6 pt-4">
          <p class="text-sm text-gray-500 font-medium flex items-center gap-2 max-w-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-sam-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><strong>Tips:</strong> Glöm inte att bifoga ditt CV (och ev. personligt brev) när ditt e-postprogram öppnas!</span>
          </p>
          <button type="submit" class="bg-sam-cyan text-white font-bold py-4 px-12 rounded-full hover:bg-sam-blue transition-colors shadow-md focus:outline-none w-full sm:w-auto cursor-pointer shrink-0">
            Skapa mejl
          </button>
        </div>
        
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('career-form');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = document.getElementById('name').value;
      const phone = document.getElementById('phone').value;
      const email = document.getElementById('email').value;
      const message = document.getElementById('message').value;

      const subject = encodeURIComponent(`Jobbansökan: ${name}`);
      const body = encodeURIComponent(
        `JOBBANSÖKAN - SAMTECH AB\n` +
        `=================================\n\n` +
        `Namn: ${name}\n` +
        `E-post: ${email}\n` +
        `Telefon: ${phone}\n\n` +
        `Presentation:\n` +
        `${message}\n\n` +
        `[BIFOGA DITT CV OCH EVENTUELLA ANDRA DOKUMENT HÄR]\n\n` +
        `=================================\n` +
        `Skickat via karriärformuläret på hemsidan.`
      );

      // Öppnar användarens lokala mejlprogram med all info förifyllt
      window.location.href = `mailto:info@sam-tech.se?subject=${subject}&body=${body}`;
    });
  }
</script>