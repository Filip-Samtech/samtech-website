---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="min-h-[75vh] flex items-center justify-center px-4 py-24 relative overflow-hidden bg-gray-50">
    
    <div class="absolute inset-0 flex items-center justify-center z-0 pointer-events-none select-none opacity-5">
      <span class="text-[15rem] md:text-[25rem] font-black text-sam-blue tracking-tighter">404</span>
    </div>

    <div class="relative z-10 text-center max-w-2xl w-full">
      <div class="bg-white p-10 md:p-16 rounded-3xl border border-gray-100 shadow-2xl backdrop-blur-sm">
        
        <div class="bg-sam-cyan/10 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-8 text-sam-cyan">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold text-sam-blue mb-4 tracking-tight">Hoppsan! Här var det tomt.</h1>
        <p class="text-lg text-gray-600 mb-10 leading-relaxed max-w-md mx-auto font-medium">
          Vi kan inte hitta sidan du letar efter. Den kanske har flyttats, eller så har det smugit sig in ett stavfel i webbadressen.
        </p>
        
        <a href="/" class="inline-flex items-center justify-center gap-2 bg-sam-blue text-white font-bold py-4 px-10 rounded-full hover:bg-sam-cyan transition-colors shadow-md focus:outline-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Tillbaka till startsidan
        </a>

      </div>
    </div>
  </section>
</Layout>